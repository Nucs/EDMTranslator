<?xml version="1.0" encoding="utf-8"?>
<package >
  <metadata>
    <id>EDMTranslator</id>
    <version>$PackageVersion$</version>
    <title>EDMTranslator</title>
    <authors>sappho192</authors>
    <owners>sappho192</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <!-- <icon>icon.png</icon> -->
    <projectUrl>https://github.com/sappho192/EDMTranslator</projectUrl>
    <repository type="git" url="https://github.com/sappho192/EDMTranslator.git" branch="$RepositoryBranch$" commit="$RepositoryCommit$" />
    <description>Text translator library based on LLM models, especially EncoderDecoderModel in HuggingFace</description>
    <copyright>Copyright (c) Taein Kim(sappho192)</copyright>
    <tags>library;translator;llm;bert;gpt;japanese;korean</tags>
    <readme>docs\README.md</readme>
    <!-- Keep these versions equal to the PackageReferences in EDMTranslator.csproj: the nuspec, not the csproj, is what
         consumers restore (1.3.1 shipped OnnxRuntime 1.17.3 / Tokenizers.DotNet 1.0.5 here while it was built against 1.22.1 / 1.2.1). -->
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="BertJapaneseTokenizer" version="1.0.9" />
        <dependency id="Microsoft.ML.OnnxRuntime" version="1.22.1" />
        <dependency id="NumSharp" version="0.80.0" />
        <dependency id="NumSharp.Interop.OnnxRuntime" version="0.80.0" />
        <dependency id="Tokenizers.DotNet" version="1.2.1" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="BertJapaneseTokenizer" version="1.0.9" />
        <dependency id="Microsoft.ML.OnnxRuntime" version="1.22.1" />
        <dependency id="NumSharp" version="0.80.0" />
        <dependency id="NumSharp.Interop.OnnxRuntime" version="0.80.0" />
        <dependency id="Tokenizers.DotNet" version="1.2.1" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\README.md" target="docs\" />
    <file src="bin\$Configuration$\net8.0\EDMTranslator.*" target="lib/net8.0" />
    <file src="bin\$Configuration$\net10.0\EDMTranslator.*" target="lib/net10.0" />
  </files>
</package>